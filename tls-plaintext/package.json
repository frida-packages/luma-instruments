{
  "name": "tls-plaintext",
  "displayName": "TLS Plaintext",
  "version": "1.1.0",
  "main": "main.ts",
  "engines": { "luma": ">=4.0.0" },
  "luma": {
    "icon": { "kind": "file", "value": "icon.png" },
    "compatibility": { "platforms": ["darwin", "linux"] },
    "settings": [
      {
        "id": "capturePayloads",
        "name": "Capture payloads",
        "schema": { "kind": "boolean", "default": true },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "hostPattern",
        "name": "Only capture hosts matching",
        "schema": { "kind": "regex", "default": "" },
        "optional": true,
        "enabledByDefault": false
      },
      {
        "id": "chunkLimit",
        "name": "Bytes kept per chunk",
        "schema": { "kind": "uint", "default": 4096, "min": 16, "max": 65536 },
        "optional": false,
        "enabledByDefault": true
      }
    ],
    "widgets": [
      {
        "id": "sent",
        "name": "Sent",
        "kind": "counter",
        "config": {},
        "actions": [{ "id": "clear", "name": "Clear" }],
        "persistence": "none"
      },
      {
        "id": "received",
        "name": "Received",
        "kind": "counter",
        "config": {},
        "actions": [{ "id": "clear", "name": "Clear" }],
        "persistence": "none"
      },
      {
        "id": "libraries",
        "name": "Libraries",
        "kind": "table",
        "config": {
          "columns": [
            { "id": "module", "name": "Module", "alignment": "leading" },
            { "id": "backend", "name": "Found as", "alignment": "leading" },
            { "id": "status", "name": "Status", "alignment": "leading" }
          ],
          "rowActions": [],
          "maxRows": 100
        },
        "persistence": "none"
      },
      {
        "id": "connections",
        "name": "Connections",
        "kind": "table",
        "config": {
          "columns": [
            { "id": "host", "name": "Host", "alignment": "leading" },
            { "id": "peer", "name": "Peer", "alignment": "leading" },
            { "id": "library", "name": "Library", "alignment": "leading" },
            { "id": "protocol", "name": "Protocol", "alignment": "leading" },
            { "id": "cipher", "name": "Cipher", "alignment": "leading" },
            { "id": "sent", "name": "Sent", "alignment": "trailing" },
            { "id": "received", "name": "Received", "alignment": "trailing" },
            { "id": "request", "name": "Last request", "alignment": "leading" },
            { "id": "active", "name": "Last active", "alignment": "trailing" }
          ],
          "rowActions": [],
          "maxRows": 1000
        },
        "actions": [{ "id": "clear", "name": "Clear" }],
        "persistence": "none"
      },
      {
        "id": "payload",
        "name": "Latest payload",
        "kind": "hex",
        "config": { "maxBytes": 65536 },
        "persistence": "none"
      }
    ],
    "layout": { "column": [
      { "row": ["sent", "received"], "foldBelow": 240 },
      { "widget": "libraries", "maxRows": 3 },
      { "widget": "connections", "share": 55, "maxRows": 10 },
      { "widget": "payload", "share": 45 }
    ] },
    "store": {
      "summary": "See a process's TLS traffic in plaintext: every OpenSSL and BoringSSL connection, also BoringSSL linked statically as in Flutter, with its host, protocol, ALPN and cipher, and the bytes it carries.",
      "category": "networking",
      "access": { "kind": "free" }
    }
  }
}
