{
  "name": "xpc-spy",
  "displayName": "XPC Spy",
  "version": "1.1.0",
  "main": "main.ts",
  "engines": { "luma": ">=4.0.0" },
  "luma": {
    "icon": { "kind": "file", "value": "icon.png" },
    "compatibility": { "platforms": ["darwin"] },
    "settings": [
      {
        "id": "services",
        "name": "Only services matching",
        "schema": { "kind": "regex", "default": "^com\\.apple\\." },
        "optional": true,
        "enabledByDefault": false
      },
      {
        "id": "backtraces",
        "name": "Capture sender backtraces",
        "schema": { "kind": "boolean", "default": false },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "dataLimit",
        "name": "Bytes kept per data value",
        "schema": { "kind": "uint", "default": 4096, "min": 0, "max": 1048576 },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "messagesPerSecond",
        "name": "Messages shown per second (more are only counted)",
        "schema": { "kind": "uint", "default": 100, "min": 1, "max": 10000 },
        "optional": false,
        "enabledByDefault": true
      }
    ],
    "widgets": [
      {
        "id": "services",
        "name": "Services",
        "kind": "table",
        "config": {
          "columns": [
            { "id": "service", "name": "Service", "alignment": "leading" },
            { "id": "peer", "name": "Peer PID", "alignment": "trailing" },
            { "id": "sent", "name": "Sent", "alignment": "trailing" },
            { "id": "received", "name": "Received", "alignment": "trailing" },
            { "id": "seen", "name": "Last seen", "alignment": "leading" },
            { "id": "last", "name": "Last message", "alignment": "leading" }
          ],
          "rowActions": [],
          "maxRows": 1000
        },
        "actions": [{ "id": "clear", "name": "Clear" }],
        "persistence": "session"
      },
      {
        "id": "messages",
        "name": "Recent messages",
        "kind": "console",
        "config": {
          "maxEntries": 500,
          "prompt": "#",
          "placeholder": "Message number to inspect",
          "runButtonLabel": "Inspect"
        },
        "actions": [{ "id": "clear", "name": "Clear" }],
        "persistence": "none"
      }
    ],
    "layout": { "column": [{ "widget": "services", "maxRows": 8 }, { "widget": "messages", "share": 1 }] },
    "store": {
      "summary": "The XPC messages a process sends and receives, per service, also on connections made before Luma attached: requests, replies and events as expandable values, with NSXPC selectors and backtraces.",
      "category": "ipc",
      "access": { "kind": "free" }
    }
  }
}
