{
  "name": "mesh-finder",
  "displayName": "Mesh Finder",
  "version": "1.1.0",
  "main": "main.ts",
  "engines": { "luma": ">=4.0.0" },
  "luma": {
    "icon": { "kind": "symbolic", "value": "magnifyingglass" },
    "compatibility": { "platforms": ["windows", "darwin", "linux"] },
    "settings": [
      {
        "id": "watchDraws",
        "name": "Learn meshes from draw calls",
        "schema": { "kind": "boolean", "default": true },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "guessUndrawn",
        "name": "Guess meshes in buffers never drawn",
        "schema": { "kind": "boolean", "default": true },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "minimumConfidence",
        "name": "Lowest confidence shown for guessed meshes (%)",
        "schema": { "kind": "uint", "default": 60, "min": 0, "max": 100 },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "minimumVertices",
        "name": "Fewest vertices a mesh must have",
        "schema": { "kind": "uint", "default": 12, "min": 1, "max": 1000000 },
        "optional": false,
        "enabledByDefault": true
      }
    ],
    "widgets": [
      {
        "id": "meshes",
        "name": "Meshes",
        "kind": "table",
        "config": {
          "columns": [
            { "id": "mesh", "name": "Mesh", "alignment": "leading" },
            { "id": "api", "name": "API", "alignment": "leading" },
            { "id": "vertices", "name": "Vertices", "alignment": "trailing" },
            { "id": "triangles", "name": "Triangles", "alignment": "trailing" },
            { "id": "size", "name": "Size", "alignment": "leading" },
            { "id": "layout", "name": "Layout", "alignment": "leading" },
            { "id": "learned", "name": "Learned from", "alignment": "leading" },
            { "id": "buffers", "name": "Buffers", "alignment": "leading" }
          ],
          "rowActions": [
            { "id": "show", "name": "Show" },
            { "id": "obj", "name": "Export OBJ" }
          ],
          "maxRows": 5000
        },
        "actions": [{ "id": "scan", "name": "Scan" }],
        "persistence": "none"
      },
      {
        "id": "mesh",
        "name": "Mesh",
        "kind": "view",
        "config": { "class": "MeshView", "height": 320 },
        "persistence": "session"
      },
      {
        "id": "viewer",
        "name": "Console",
        "kind": "console",
        "config": {
          "maxEntries": 500,
          "prompt": ">",
          "placeholder": "show 3, obj 3, scan, help",
          "runButtonLabel": "Run"
        },
        "actions": [{ "id": "clear", "name": "Clear" }],
        "persistence": "none"
      }
    ],
    "layout": { "column": [
      { "widget": "meshes", "share": 45, "maxRows": 6 },
      { "row": [{ "widget": "mesh", "share": 60 }, { "widget": "viewer", "share": 40 }], "share": 55 }
    ] },
    "store": {
      "summary": "Find the 3D meshes a game or app holds in its Direct3D 11, Metal, Vulkan and OpenGL buffers, with exact layouts learned from its draw calls, and export any of them as OBJ.",
      "category": "ui",
      "access": { "kind": "free" }
    }
  }
}
