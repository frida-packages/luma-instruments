{
  "name": "lua-hunter",
  "displayName": "Lua Hunter",
  "version": "1.1.1",
  "main": "main.ts",
  "engines": { "luma": ">=4.1.0" },
  "luma": {
    "icon": { "kind": "file", "value": "icon.png" },
    "compatibility": { "platforms": ["windows", "darwin", "linux"] },
    "settings": [
      {
        "id": "scanMemory",
        "name": "Find idle interpreters in memory",
        "schema": { "kind": "boolean", "default": true },
        "optional": false,
        "enabledByDefault": true
      },
      {
        "id": "entriesPerTable",
        "name": "Entries shown per table",
        "schema": { "kind": "uint", "default": 100, "min": 1, "max": 10000 },
        "optional": false,
        "enabledByDefault": true
      }
    ],
    "widgets": [
      {
        "id": "status",
        "kind": "list",
        "config": { "rowActions": [], "maxItems": 1 },
        "persistence": "none"
      },
      {
        "id": "interpreters",
        "name": "Interpreters",
        "kind": "table",
        "config": {
          "columns": [
            { "id": "number", "name": "#", "alignment": "trailing" },
            { "id": "lua", "name": "Lua", "alignment": "leading" },
            { "id": "code", "name": "Code in", "alignment": "leading" },
            { "id": "state", "name": "Main lua_State", "alignment": "leading" },
            { "id": "thread", "name": "Thread", "alignment": "trailing" },
            { "id": "globals", "name": "Globals", "alignment": "leading" },
            { "id": "status", "name": "Status", "alignment": "leading" }
          ],
          "rowActions": [],
          "rowActivation": { "id": "show", "name": "Show" },
          "maxRows": 256
        },
        "actions": [{ "id": "scan", "name": "Scan" }],
        "persistence": "none"
      }
    ],
    "layout": { "column": ["status", { "widget": "interpreters", "maxRows": 6 }] },
    "children": [
      {
        "id": "interpreter",
        "name": "Interpreters",
        "icon": { "kind": "symbolic", "value": "cpu" },
        "widgets": [
          {
            "id": "console",
            "name": "Lua",
            "kind": "console",
            "config": {
              "maxEntries": 1000,
              "prompt": ">",
              "placeholder": "Lua to run in this interpreter, or :help",
              "runButtonLabel": "Run"
            },
            "actions": [{ "id": "clear", "name": "Clear" }],
            "persistence": "none"
          }
        ],
        "layout": { "column": [{ "widget": "console", "share": 1 }] }
      }
    ],
    "store": {
      "summary": "Find the Lua interpreters embedded in a process (Lua 5.1 to 5.4 and LuaJIT, exported, with symbols or stripped) and run Lua in any of them, on its own thread, from a console.",
      "category": "runtime",
      "access": { "kind": "free" }
    }
  }
}
